{
  "name": "@nijaru/pi-tps",
  "version": "0.0.1",
  "type": "module",
  "description": "Per-request TTFT and tokens-per-second for pi, with session averages in the footer.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "timing",
    "ttft",
    "latency",
    "throughput"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Nick Naru <nick@nijaru.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nijaru/pi-tps.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "bun test",
    "lint": "oxlint extensions/ tests/",
    "typecheck": "tsc --noEmit",
    "check": "bun test && oxlint extensions/ tests/ && tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/bun": "latest",
    "oxlint": "latest",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ]
}
